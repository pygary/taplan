    "import pandas as pd\n",
    "import logging\n",
    "import os\n",
    "\n",
    "# Set up logging\n",
    "logging.basicConfig(level=logging.INFO)\n",
    "\n",
    "def create_directory(path):\n",
    "    \"\"\"Create directory if it does not exist.\"\"\"\n",
    "    if not os.path.exists(path):\n",
    "        os.makedirs(path)\n",
    "        logging.info(f\"Created directory: {path}\")\n",
    "\n",
    "def load_excel_sheets(file_path, exclude_sheets=None):\n",
    "    \"\"\"Load sheets from an Excel file, excluding specified sheets.\"\"\"\n",
    "    if exclude_sheets is None:\n",
    "        exclude_sheets = []\n",
    "    with pd.ExcelFile(file_path) as xls:\n",
    "        sheets_to_keep = [sheet for sheet in xls.sheet_names if sheet not in exclude_sheets]\n",
    "        return {sheet: pd.read_excel(xls, sheet_name=sheet) for sheet in sheets_to_keep}\n",
    "\n",
    "def clean_dataframe(df, date):\n",
    "    \"\"\"Clean the DataFrame according to specified rules.\"\"\"\n",
    "    df.columns = df.columns.str.strip()  # Standardize column names\n",
    "    df['日期'] = date  # Set the date column\n",
    "    \n",
    "    if len(df) > 2:\n",
    "        df = df.drop(index=[0, 1]).reset_index(drop=True)\n",
    "    \n",
    "    # Replace '-' in '未平倉合約變動' with 0\n",
    "    df['未平倉合約變動'] = df['未平倉合約變動'].replace('-', 0).astype(float)\n",
    "    \n",
    "    # Convert specified columns to numeric, forcing errors to NaN\n",
    "    for col in ['結算價', '未平倉合約變動']:\n",
    "        df[col] = pd.to_numeric(df[col], errors='coerce')\n",
    "\n",
    "    # Remove rows that are entirely zero or empty\n",
    "    df = df[(df != 0).any(axis=1) & (df.notna().any(axis=1))]\n",
    "\n",
    "    # Drop last row and rows with '行使價' and '開市' as NaN\n",
    "    df = df[:-1]\n",
    "    df = df.dropna(subset=['行使價', '開市'], how='all')\n",
    "\n",
    "    return df\n",
    "\n",
    "def process_excel_file(date):\n",
    "    \"\"\"Process the Excel file for the given date.\"\"\"\n",
    "    try:\n",
    "        file_path = fr'C:\\\\pythonData\\\\result_hs_stockopt\\\\uat\\\\raw\\\\{date}_Steps5_combo.xlsx'\n",
    "        output_directory = fr'C:\\\\pythonData\\\\result_hs_stockopt\\\\uat\\\\split\\\\{date}'\n",
    "        output_file_path = os.path.join(output_directory, f'{date}_cleaned.xlsx')\n",
    "        \n",
    "        create_directory(output_directory)\n",
    "        \n",
    "        # Load the Excel file and exclude \"Sheet1\" and \"Sheet2\" if they exist\n",
    "        data_frames = load_excel_sheets(file_path, exclude_sheets=[\"Sheet1\", \"Sheet2\"])\n",
    "\n",
    "        with pd.ExcelWriter(output_file_path, engine='openpyxl') as writer:\n",
    "            for sheet_name, df in data_frames.items():\n",
    "                cleaned_df = clean_dataframe(df, date)\n",
    "                cleaned_df.to_excel(writer, sheet_name=sheet_name, index=False)\n",
    "                logging.info(f'Successfully processed and wrote data for {sheet_name} on {date}')\n",
    "        \n",
    "        # Delete the original Steps5_combo file after processing\n",
    "        os.remove(file_path)\n",
    "        logging.info(f\"Deleted original file: {file_path}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        logging.error(f\"An error occurred while processing date {date}: {e}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    datasetting = [input(\"輸入日期 \")]\n",
    "    \n",
    "    for date in datasetting:\n",
    "        process_excel_file(date)"
