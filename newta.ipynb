    "import os\n",
    "import logging\n",
    "import requests\n",
    "import pandas as pd\n",
    "from tqdm import tqdm, trange\n",
    "\n",
    "# Setup logging\n",
    "logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n",
    "\n",
    "def log_info(message):\n",
    "    logging.info(message)\n",
    "\n",
    "def download_and_load_csv(url, encoding='big5'):\n",
    "    \"\"\"Download CSV file and load into DataFrame.\"\"\"\n",
    "    try:\n",
    "        response = requests.get(url)\n",
    "        response.raise_for_status()\n",
    "        log_info(f\"CSV file successfully downloaded from {url}.\")\n",
    "        return pd.read_csv(pd.compat.StringIO(response.content.decode(encoding)), encoding=encoding, errors='ignore')\n",
    "    except requests.RequestException as e:\n",
    "        logging.error(f\"Download failed: {e}\")\n",
    "        raise\n",
    "    except pd.errors.ParserError as e:\n",
    "        logging.error(f\"CSV parsing failed: {e}\")\n",
    "        raise\n",
    "\n",
    "def save_dataframe_to_excel(df, excel_path, sheet_name='Sheet1', header=False):\n",
    "    \"\"\"Save DataFrame to specified Excel file.\"\"\"\n",
    "    try:\n",
    "        with pd.ExcelWriter(excel_path, engine='openpyxl') as writer:\n",
    "            df.to_excel(writer, sheet_name=sheet_name, index=False, header=header)\n",
    "        log_info(f\"Excel file saved to: {excel_path}\")\n",
    "    except Exception as e:\n",
    "        logging.error(f\"Failed to save Excel file: {e}\")\n",
    "        raise\n",
    "\n",
    "def get_row_indices(df, start_label, end_label=None):\n",
    "    \"\"\"Get row indices for specified labels.\"\"\"\n",
    "    start_row = df[df.iloc[:, 0].astype(str).str.strip() == start_label].index\n",
    "    if start_row.empty:\n",
    "        raise ValueError(f\"'{start_label}' not found\")\n",
    "    if end_label:\n",
    "        end_row = df[df.iloc[:, 0].astype(str).str.strip() == end_label].index\n",
    "        if end_row.empty:\n",
    "            raise ValueError(f\"'{end_label}' not found\")\n",
    "        return start_row[0], end_row[0] + 1\n",
    "    return start_row[0], None\n",
    "\n",
    "def extract_relevant_rows(df, start_label='HKATS 代號', end_label='ZSH'):\n",
    "    \"\"\"Extract rows between specified start and end labels.\"\"\"\n",
    "    start_row, end_row = get_row_indices(df, start_label, end_label)\n",
    "    return df.iloc[start_row:end_row, :]\n",
    "\n",
    "def extract_top_trades(df, start_label='十大成交(按成交量)', num_rows=13):\n",
    "    \"\"\"Extract rows starting from specified label.\"\"\"\n",
    "    start_row, _ = get_row_indices(df, start_label)\n",
    "    return df.iloc[start_row:start_row + num_rows, :]\n",
    "\n",
    "def extract_all_contract_rows(df, filename):\n",
    "    \"\"\"Extract all contract rows and organize them into sheets.\"\"\"\n",
    "    rows_dict = {}\n",
    "    start_row = None\n",
    "\n",
    "    for i, value in tqdm(df.iloc[:, 0].items(), desc=\"Processing rows\"):\n",
    "        if str(value).strip() == '合約':\n",
    "            start_row = i\n",
    "        elif start_row and str(df.iloc[i, 7]).strip() == '認沽總計':\n",
    "            full_name = df.iloc[start_row + 2, 0].strip()\n",
    "            sheet_name = full_name.split('-')[0].strip()[:31]  # Excel sheet name length limit is 31\n",
    "            rows_dict[sheet_name] = df.iloc[start_row:i+1, :].reset_index(drop=True).assign(日期=filename)\n",
    "            start_row = None\n",
    "\n",
    "    if not rows_dict:\n",
    "        raise ValueError(\"No '合約' to '認沽總計' groups found.\")\n",
    "    return rows_dict\n",
    "\n",
    "def process_and_save_to_excel(filename, output_path):\n",
    "    \"\"\"Process each file and save as Excel.\"\"\"\n",
    "    file_path = os.path.join('C:\\\\pythonData\\\\result_hs_stockopt\\\\uat\\\\raw', f'{filename}.xlsx')\n",
    "    df = pd.read_excel(file_path, header=None)\n",
    "\n",
    "    # Extract data\n",
    "    relevant_df = extract_relevant_rows(df)\n",
    "    top_trades_df = extract_top_trades(df)\n",
    "    all_contract_rows_dict = extract_all_contract_rows(df, filename)\n",
    "\n",
    "    # Save to Excel\n",
    "    with pd.ExcelWriter(output_path, engine='openpyxl') as writer:\n",
    "        relevant_df.to_excel(writer, index=False, header=False, sheet_name='Sheet1')\n",
    "        top_trades_df.to_excel(writer, index=False, header=False, sheet_name='Sheet2')\n",
    "        for sheet_name, contract_df in all_contract_rows_dict.items():\n",
    "            contract_df.to_excel(writer, index=False, header=False, sheet_name=sheet_name)\n",
    "    log_info(f\"Excel file processed and saved as: {output_path}\")\n",
    "\n",
    "def update_sheet_names_and_format(input_path, output_path):\n",
    "    \"\"\"Update column names and format of sheets.\"\"\"\n",
    "    sheet1_cols = [\"代號\", \"正股名稱\", \"No\", \"總計Vol\", \"認購\", \"認沽\", \"總計OI\", \"認購\", \"認沽\", \"引申波幅%\"]\n",
    "    sheet2_cols = [\"認購認沽十大\", \"代號\", \"合約\", \"行使價\", \"成交量\", \"結算價\", \"引申波幅%\", \"最高\", \"最低\", \"未平倉合約\", \"結算價變動\", \"結算價變動百份比\"]\n",
    "\n",
    "    sheets_dict = pd.read_excel(input_path, sheet_name=None, header=None)\n",
    "    for sheet_name, df in sheets_dict.items():\n",
    "        if sheet_name == \"Sheet1\":\n",
    "            df.columns = sheet1_cols\n",
    "        elif sheet_name == \"Sheet2\":\n",
    "            df.columns = sheet2_cols\n",
    "        else:\n",
    "            df = df.iloc[2:].reset_index(drop=True)\n",
    "            df.columns = [\"認購認沽\", \"合約\", \"行使價\", \"開市\", \"全日最高\", \"全日最低\", \"結算價\", \"結算價變動\", \"引申波幅%\", \"成交量\", \"未平倉合約\", \"未平倉合約變動\", \"日期\"]\n",
    "            df.dropna(how='all', inplace=True)\n",
    "        sheets_dict[sheet_name] = df[~df.iloc[:, 0].astype(str).str.contains('類別', na=False)]\n",
    "\n",
    "    with pd.ExcelWriter(output_path, engine='openpyxl') as writer:\n",
    "        for sheet_name, df in sheets_dict.items():\n",
    "            df.to_excel(writer, sheet_name=sheet_name.replace(\"類別 \", \"\"), index=False)\n",
    "    log_info(f\"Excel file updated and saved to: {output_path}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    filenames = input(\"Enter stock option data filenames, separated by commas (e.g., 240605,250104): \").split(\",\")\n",
    "    filenames = [filename.strip() for filename in filenames]\n",
    "\n",
    "    for i in trange(len(filenames), desc=\"Processing files\", unit=\"file\"):\n",
    "        filename = filenames[i]\n",
    "        intermediate_output = os.path.join('C:\\\\pythonData\\\\result_hs_stockopt\\\\uat\\\\raw', f'{filename}_not_start_names.xlsx')\n",
    "        final_output = os.path.join('C:\\\\pythonData\\\\result_hs_stockopt\\\\uat\\\\raw', f'{filename}_Steps5_combo.xlsx')\n",
    "\n",
    "        process_and_save_to_excel(filename, intermediate_output)\n",
    "        update_sheet_names_and_format(intermediate_output, final_output)\n",
    "        os.remove(intermediate_output)\n",
    "        log_info(f\"Intermediate file deleted: {intermediate_output}\")\n",
    "\n",
    "        log_info(f\"Updated Excel file saved at: {final_output}\")"
   ]
