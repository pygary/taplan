    "import os \n",
    "import re\n",
    "import shutil\n",
    "import time\n",
    "from datetime import datetime\n",
    "import pandas as pd\n",
    "from IPython.display import display, HTML\n",
    "\n",
    "def join_path(*args):\n",
    "    \"\"\"組合文件路徑\"\"\"\n",
    "    return os.path.join(*args)\n",
    "\n",
    "def ensure_dir(directory):\n",
    "    \"\"\"確保文件夾存在\"\"\"\n",
    "    os.makedirs(directory, exist_ok=True)\n",
    "\n",
    "def timing(func):\n",
    "    \"\"\"計算執行時間的裝飾器\"\"\"\n",
    "    def wrapper(*args, **kwargs):\n",
    "        start_time = time.time()\n",
    "        result = func(*args, **kwargs)\n",
    "        end_time = time.time()\n",
    "        return result\n",
    "    return wrapper\n",
    "\n",
    "def sanitize_filename(filename):\n",
    "    \"\"\"移除文件名中不合法的字符\"\"\"\n",
    "    return re.sub(r'[<>:\"/\\\\|?*]', '', filename)\n",
    "\n",
    "@timing\n",
    "def move_files_to_new_directory(src_dir, dst_dir):\n",
    "    ensure_dir(dst_dir)\n",
    "    for file_name in os.listdir(src_dir):\n",
    "        if file_name.endswith('.xlsx'):\n",
    "            shutil.move(join_path(src_dir, file_name), join_path(dst_dir, file_name))\n",
    "\n",
    "@timing\n",
    "def process_raw_data(file_name_input):\n",
    "    base_path = join_path('C:\\\\pythonData\\\\result_hs_index', 'uat', 'raw')\n",
    "    excel_file = join_path(base_path, f'{file_name_input}.xlsx')\n",
    "    df = pd.read_excel(excel_file, engine='openpyxl', header=None)\n",
    "    \n",
    "    df = df.drop(index=range(0, 25)).reset_index(drop=True)\n",
    "    if not df.empty:\n",
    "        df.columns = df.iloc[0]\n",
    "        df = df[1:].reset_index(drop=True)\n",
    "    df.replace('-', 0, inplace=True)\n",
    "    df = df.dropna(how='all')\n",
    "    \n",
    "    # 濾除不需要的行\n",
    "    filters = ['認購總計', '認沽總計', '合約月份總計', '市場認沽/認購比率', '市場總計', '*** 全表完 ***', '*不包括組合對組合買賣交易', '合約月份認沽/認購比率']\n",
    "    df = df[~df.iloc[:, 15].isin(filters)]\n",
    "    \n",
    "    # 移除無用列\n",
    "    columns_to_remove = ['*開市', '*全日最高', '*全日最低', '正式收市價', '結算價變動', '*開市.1', '*全日最高.1', '*全日最低.1', '*合約最高', '*合約最低']\n",
    "    df.drop(columns=columns_to_remove, axis=1, inplace=True, errors='ignore')\n",
    "    \n",
    "    # 更新欄位名稱\n",
    "    df.columns = ['合約月份', '行使價', '認購/認沽', '成交量1', '結算價', '引申波幅%', '成交量2', '成交量3','未平倉合約', '未平倉合約變動']\n",
    "    df = df.drop(df.columns[[3, 6]], axis=1)\n",
    "    \n",
    "    df.to_excel(join_path(base_path, f'{file_name_input}_cleaned_data.xlsx'), index=False, engine='openpyxl')\n",
    "\n",
    "@timing\n",
    "def split_and_save(file_name_input):\n",
    "    base_path = join_path('C:\\\\pythonData\\\\result_hs_index', 'uat', 'raw')\n",
    "    file_path = join_path(base_path, f'{file_name_input}_cleaned_data.xlsx')\n",
    "    df = pd.read_excel(file_path)\n",
    "    grouped = df.groupby('合約月份')\n",
    "    result_dir = join_path('C:\\\\pythonData\\\\result_hs_index', 'uat', 'split')\n",
    "    ensure_dir(result_dir)\n",
    "\n",
    "    def reformat_month(month_str):\n",
    "        try:\n",
    "            year, month = month_str.split(' 年 ')\n",
    "            year = year[-2:]\n",
    "            month = month[:2]\n",
    "            return f'{year}{month}'\n",
    "        except ValueError:\n",
    "            return month_str\n",
    "\n",
    "    for name, group in grouped:\n",
    "        if name.strip() in ['不包括組合對組合買賣交易', '合約月份']:\n",
    "            continue\n",
    "\n",
    "        new_name = sanitize_filename(reformat_month(name))\n",
    "        group.to_excel(join_path(result_dir, f'{new_name}_combo.xlsx'), index=False)\n",
    "\n",
    "    unwanted_file = join_path(result_dir, '不包括組合對組合買賣交易_combo.xlsx')\n",
    "    if os.path.exists(unwanted_file):\n",
    "        os.remove(unwanted_file)\n",
    "\n",
    "@timing\n",
    "def process_option_data():\n",
    "    directory = join_path('C:\\\\pythonData\\\\result_hs_index', 'uat', 'split')\n",
    "    if not os.path.exists(directory):\n",
    "        print(f\"目錄 {directory} 不存在，請確認路徑是否正確。\")\n",
    "        return\n",
    "\n",
    "    for filename in os.listdir(directory):\n",
    "        if filename.endswith(\".xlsx\"):\n",
    "            file_path = join_path(directory, filename)\n",
    "            df = pd.read_excel(file_path, sheet_name='Sheet1', engine='openpyxl')\n",
    "\n",
    "            df['結算價'] = pd.to_numeric(df['結算價'], errors='coerce')\n",
    "            df['未平倉合約'] = pd.to_numeric(df['未平倉合約'], errors='coerce')\n",
    "            df['期權資金流'] = df['結算價'] * df['未平倉合約'] * 50\n",
    "            \n",
    "            if '未平倉合約變動' in df.columns:\n",
    "                df['即日期權資金流'] = df['結算價'] * df['未平倉合約變動'] * 50\n",
    "            \n",
    "            contract_month = df['合約月份'].iloc[0]\n",
    "            total_open_interest_calls = df[df['認購/認沽'] == '認購']['未平倉合約'].sum()\n",
    "            total_open_interest_puts = df[df['認購/認沽'] == '認沽']['未平倉合約'].sum()\n",
    "            total_option_flow_calls = df[df['認購/認沽'] == '認購']['期權資金流'].sum()\n",
    "            total_option_flow_puts = df[df['認購/認沽'] == '認沽']['期權資金流'].sum()\n",
    "\n",
    "            summary_df = pd.DataFrame({\n",
    "                '合約月份': [contract_month, contract_month],\n",
    "                '類別': ['認購', '認沽'],\n",
    "                '未平倉合約總和': [total_open_interest_calls, total_open_interest_puts],\n",
    "                '期權資金流總和': [total_option_flow_calls, total_option_flow_puts]\n",
    "            })\n",
    "\n",
    "            output_file = join_path(directory, filename)\n",
    "            with pd.ExcelWriter(output_file, engine='openpyxl') as writer:\n",
    "                df.to_excel(writer, sheet_name='Sheet1', index=False, freeze_panes=(1, 0))\n",
    "                summary_df.to_excel(writer, sheet_name='Summary', index=False)\n",
    "\n",
    "@timing\n",
    "def finalize_files(file_name_input):\n",
    "    split_directory = join_path('C:\\\\pythonData\\\\result_hs_index', 'uat', 'split')\n",
    "    timestamp_folder = join_path(split_directory, f'{file_name_input}_{datetime.now().strftime(\"%Y%m%d_%H%M%S\")}')\n",
    "    move_files_to_new_directory(split_directory, timestamp_folder)\n",
    "    print(f\"已完成處理---恒生指數期權資料： {timestamp_folder}\")\n",
    "\n",
    "def main():\n",
    "    file_name_inputs = input(\"恒生指數期權資料（如：240606,240605,240604）：\")\n",
    "    if file_name_inputs:\n",
    "        file_name_list = file_name_inputs.split(',')\n",
    "        for file_name_input in file_name_list:\n",
    "            file_name_input = file_name_input.strip()\n",
    "            process_file(file_name_input)\n",
    "    else:\n",
    "        print(\"未輸入文件名。請重新輸入。\")\n",
    "\n",
    "def process_file(file_name_input):\n",
    "    process_raw_data(file_name_input)\n",
    "    split_and_save(file_name_input)\n",
    "    process_option_data()\n",
    "    finalize_files(file_name_input)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
  },
