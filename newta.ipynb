    "    \n",
    "    columns_to_remove = ['*開市', '*全日最高', '*全日最低', '正式收市價',  '結算價變動', '*開市.1', '*全日最高.1', '*全日最低.1', '*合約最高', '*合約最低']\n",
    "    df.drop(columns=columns_to_remove, axis=1, inplace=True, errors='ignore')\n",
