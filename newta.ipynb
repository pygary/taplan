    "import os\n",
    "import shutil\n",
    "import pandas as pd\n",
    "from IPython.display import display, HTML\n",
    "import re\n",
    "import requests\n",
    "import tempfile\n",
    "from win32com.client import Dispatch\n",
    "\n",
    "def move_files_to_new_directory(src_dir, dst_dir):\n",
    "    os.makedirs(dst_dir, exist_ok=True)\n",
    "    for file_name in os.listdir(src_dir):\n",
    "        file_path = os.path.join(src_dir, file_name)\n",
    "        if file_name.endswith('.xlsx') and not os.path.isdir(file_path):\n",
    "            shutil.move(file_path, os.path.join(dst_dir, file_name))\n",
    "\n",
    "def combine_excel_files(directory, combined_file_path):\n",
    "    combined_df = pd.DataFrame()\n",
    "    for file in os.listdir(directory):\n",
    "        if file.endswith('.xlsx'):\n",
    "            df = pd.read_excel(os.path.join(directory, file))\n",
    "            combined_df = pd.concat([combined_df, df], ignore_index=True)\n",
    "    combined_df.to_excel(combined_file_path, index=False)\n",
    "\n",
    "def download_csv_and_convert_to_xlsx(url, xlsx_file_path):\n",
    "    # 创建临时文件\n",
    "    with tempfile.NamedTemporaryFile(delete=False, suffix='.csv') as temp_csv_file:\n",
    "        csv_file_path = temp_csv_file.name\n",
    "    \n",
    "    # 下载 CSV 文件\n",
    "    response = requests.get(url)\n",
    "    if response.status_code == 200:\n",
    "        # 将下载的内容保存到临时 CSV 文件\n",
    "        with open(csv_file_path, 'wb') as file:\n",
    "            file.write(response.content)\n",
    "        print(f\"CSV 文件已成功下载并保存为 {csv_file_path}。\")\n",
    "        \n",
    "        # 打开 Excel 程序并加载 CSV 文件\n",
    "        try:\n",
    "            excel = Dispatch(\"Excel.Application\")\n",
    "            excel.Visible = False\n",
    "            workbook = excel.Workbooks.Open(os.path.abspath(csv_file_path))\n",
    "            workbook.Worksheets(1).Name = \"Sheet1\"\n",
    "            workbook.SaveAs(os.path.abspath(xlsx_file_path), FileFormat=51)  # 51 是 XLSX 格式\n",
    "            workbook.Close()\n",
    "            excel.Quit()\n",
    "            print(f\"CSV 文件已成功转换并保存为 XLSX 文件：{xlsx_file_path}\")\n",
    "        except Exception as e:\n",
    "            print(f\"无法处理 Excel 文件：{e}\")\n",
    "        finally:\n",
    "            os.remove(csv_file_path)  # 删除临时文件\n",
    "    else:\n",
    "        print(f\"下载失败，状态码：{response.status_code}\")\n",
    "\n",
