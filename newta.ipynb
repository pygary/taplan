    "        print(f\"目錄 {directory} 不存在，請確認路徑是否正確。\")\n",
    "        return\n",
    "\n",
    "    for filename in os.listdir(directory):\n",
    "        if filename.endswith(\".xlsx\"):\n",
    "            file_path = join_path(directory, filename)\n",
    "            df = pd.read_excel(file_path, sheet_name='Sheet1', engine='openpyxl')\n",
    "\n",
    "            df['結算價'] = pd.to_numeric(df['結算價'], errors='coerce')\n",
    "            df['未平倉合約'] = pd.to_numeric(df['未平倉合約'], errors='coerce')\n",
    "            df['期權資金流'] = df['結算價'] * df['未平倉合約'] * 50\n",
    "            \n",
    "            if '未平倉合約變動' in df.columns:\n",
    "                df['即日期權資金流'] = df['結算價'] * df['未平倉合約變動'] * 50\n",
    "            \n",
    "            contract_month = df['合約月份'].iloc[0]\n",
    "            total_open_interest_calls = df[df['認購/認沽'] == '認購']['未平倉合約'].sum()\n",
    "            total_open_interest_puts = df[df['認購/認沽'] == '認沽']['未平倉合約'].sum()\n",
    "            total_option_flow_calls = df[df['認購/認沽'] == '認購']['期權資金流'].sum()\n",
    "            total_option_flow_puts = df[df['認購/認沽'] == '認沽']['期權資金流'].sum()\n",
    "\n",
    "            summary_df = pd.DataFrame({\n",
    "                '合約月份': [contract_month, contract_month],\n",
    "                '類別': ['認購', '認沽'],\n",
    "                '未平倉合約總和': [total_open_interest_calls, total_open_interest_puts],\n",
    "                '期權資金流總和': [total_option_flow_calls, total_option_flow_puts]\n",
    "            })\n",
    "\n",
    "            output_file = join_path(directory, filename)\n",
    "            with pd.ExcelWriter(output_file, engine='openpyxl') as writer:\n",
    "                df.to_excel(writer, sheet_name='Sheet1', index=False, freeze_panes=(1, 0))\n",
    "                summary_df.to_excel(writer, sheet_name='Summary', index=False)\n",
    "\n",
    "@timing\n",
    "def finalize_files(file_name_input):\n",
    "    print(f\"已完成處理---恒生國企期權資料：: {timestamp_folder}\")\n",
    "\n",
    "def main():\n",
    "    file_name_inputs = input(\"恒生國企期權資料（如：240606,240605,240604）：\")\n",
    "    if file_name_inputs:\n",
    "        file_name_list = file_name_inputs.split(',')\n",
    "        for file_name_input in file_name_list:\n",
    "            file_name_input = file_name_input.strip()\n",
    "            process_file(file_name_input)\n",
    "    else:\n",
    "        print(\"未輸入文件名。請重新輸入。\")\n",
    "\n",
    "def process_file(file_name_input):\n",
    "    process_raw_data(file_name_input)\n",
    "    split_and_save(file_name_input)\n",
    "    process_option_data()\n",
    "    finalize_files(file_name_input)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
  }
